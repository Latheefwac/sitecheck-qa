# Copy to .env.local and fill in. Restart the server after changes.

# Admin password. When set, the whole platform needs sign-in except developer share links (/share/…).
# Set this before sending share links to anyone, or developers can open every project.
QA_ADMIN_PASSWORD=

# Optional: key used to encrypt stored scan credentials and share-link tokens.
# If unset, one is generated in data/.secret-key.
QA_SECRET_KEY=
